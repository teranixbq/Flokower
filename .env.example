# ═══════════════════════════════════════════════════════
# FLOKOWER - Environment Variables Template
# ═══════════════════════════════════════════════════════
#
# Copy file ini ke .env lalu isi dengan nilai asli kamu.
# File .env TIDAK boleh di-commit ke git!
#
# Cara pakai:
#   1. cp .env.example .env
#   2. Isi nilai-nilai di bawah
#   3. flutter run (langsung, tanpa flag tambahan)
#
# ⚠️ PENTING:
# - Untuk test di CHROME/WEB → pakai Web App config
# - Untuk test di ANDROID → pakai Android App config
# Keduanya bisa dilihat di Firebase Console → Project Settings → Your apps
#

# ─── Firebase ─────────────────────────────────────────
# Untuk WEB, ambil dari: Firebase Console → Web app config
# Untuk ANDROID, ambil dari: google-services.json
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=flokower
FIREBASE_STORAGE_BUCKET=flokower.firebasestorage.app
FIREBASE_AUTH_DOMAIN=flokower.firebaseapp.com

# ─── App ──────────────────────────────────────────────
APP_NAME=Flokower
APP_ENV=development
